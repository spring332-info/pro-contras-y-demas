using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class playerMovement : MonoBehaviour
{

    //variables que se pueden modificar en el inspector 
    // float decimal - int Numero entero - Bool condicional - String caracteres
    public float velocidad = 2f;
    public float fuerzaSalto = 5f;
    public float velocidadTurbo = 10f;
  
    
    
    public bool enSuelo = true;

    private Rigidbody rb; //Se usa para guardar el componente Rigidbody del player

    // Start is called before the first frame update
    void Start()
    {
        rb = GetComponent<Rigidbody>();  // busque el componente del objeto y lo guarda en rb
    }

    // Update is called once per frame
    void Update()
    {

        //detectar el nitro del personaje

        if (Input.GetKey(KeyCode.LeftShift))
		{
            velocidad = velocidadTurbo;
		}
        else
        {
            velocidad = 2f;
        }

        // movimiento
        float moverX = Input.GetAxis("Horizontal"); // Detecta teclas A y D - Flechas <izquierda y derecha>
        float moverZ = Input.GetAxis("Vertical"); // Deteca teclas W y S - Flechas arriba y abajo

        Vector3 movimiento = new Vector3(moverX, 0, moverZ);
        transform.Translate(movimiento * velocidad * Time.deltaTime); // hace que el movimiento sea igual independiente de los fps 

        /* if (Input.GetKey(KeyCode.LeftShift))
        {
            velocidad = 5f; 
        }
        else
        {
            velocidad = 2f;
		} */

        // salto - Mueve al personaje 
        if (Input.GetKeyDown(KeyCode.Space) && enSuelo) // condicional de si se preciona la tecla ESPACIO y que el jugador este tocando el suelo (&& = y ademas)
        {
            rb.AddForce(Vector3.up * fuerzaSalto, ForceMode.Impulse); // Agrega fuerza hacia arriba 
            enSuelo = false;
        }
    }

	private void OnCollisionEnter(Collision collision) //detecta si nuestro jugador toca algo 
	{
		//Aca va a detectar cuando toca el suelo
        if (collision.gameObject.CompareTag("Suelo")) //revisa si el gameobject que toca tiene el tag Suelo
        {
            enSuelo = true; //si tiene el tag suelo, pasa a true por lo que puede volver a saltar 
        }
    }
}

