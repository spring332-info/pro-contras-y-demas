using UnityEngine;

public class Estabilizador : MonoBehaviour
{
    public float velocidadEstabilizacion = 5f;

    void FixedUpdate()
    {
        Quaternion rotacionDeseada = Quaternion.Euler(0, transform.eulerAngles.y, 0);

        transform.rotation = Quaternion.Slerp(
            transform.rotation,
            rotacionDeseada,
            velocidadEstabilizacion * Time.fixedDeltaTime
        );
    }
}

